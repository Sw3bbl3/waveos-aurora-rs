+/*
+ * Pages are drawn zoomed (twice the size on a WaveOS screen at 2x), and
+ * hinted glyphs don't grow in proportion. Layout measures text at the size
+ * it is drawn (as html redraw sizes it) and converts back, so laid-out
+ * lines fit what is drawn.
+ */
+static float
+waveos_text_scale(void)
+{
+	return waveos_zoom > 0 ? waveos_zoom : waveos_scale();
+}
+
+static plot_font_style_t
+waveos_drawn_style(const plot_font_style_t *fstyle, float s)
+{
+	plot_font_style_t drawn = *fstyle;
+	drawn.size *= s;
+	return drawn;
+}
+
+static int
+waveos_layout_units(int drawn, float s)
+{
+	return (int)(drawn / s + 0.999f);
+}
+
+static nserror
+waveos_font_width(const plot_font_style_t *fstyle,
+		const char *string, size_t length, int *width)
+{
+	float s = waveos_text_scale();
+	plot_font_style_t drawn = waveos_drawn_style(fstyle, s);
+	nserror res = fb_font_width(&drawn, string, length, width);
+	*width = waveos_layout_units(*width, s);
+	return res;
+}
+
+static nserror
+waveos_font_position(const plot_font_style_t *fstyle,
+		const char *string, size_t length,
+		int x, size_t *char_offset, int *actual_x)
+{
+	float s = waveos_text_scale();
+	plot_font_style_t drawn = waveos_drawn_style(fstyle, s);
+	nserror res = fb_font_position(&drawn, string, length, (int)(x * s),
+			char_offset, actual_x);
+	*actual_x = waveos_layout_units(*actual_x, s);
+	return res;
+}
+
+static nserror
+waveos_font_split(const plot_font_style_t *fstyle,
+		const char *string, size_t length,
+		int x, size_t *char_offset, int *actual_x)
+{
+	float s = waveos_text_scale();
+	plot_font_style_t drawn = waveos_drawn_style(fstyle, s);
+	nserror res = fb_font_split(&drawn, string, length, (int)(x * s),
+			char_offset, actual_x);
+	*actual_x = waveos_layout_units(*actual_x, s);
+	return res;
+}
+
 static struct gui_layout_table layout_table = {
-	.width = fb_font_width,
-	.position = fb_font_position,
-	.split = fb_font_split,
+	.width = waveos_font_width,
+	.position = waveos_font_position,
+	.split = waveos_font_split,
 };
 
 struct gui_layout_table *framebuffer_layout_table = &layout_table;
