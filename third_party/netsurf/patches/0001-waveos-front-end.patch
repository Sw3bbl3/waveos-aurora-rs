diff -ruN a/netsurf/frontends/framebuffer/waveos.h b/netsurf/frontends/framebuffer/waveos.h
--- a/netsurf/frontends/framebuffer/waveos.h
+++ b/netsurf/frontends/framebuffer/waveos.h
@@ -0,0 +1,20 @@
+/* WaveOS's part of NetSurf's framebuffer front end (waveos/netsurf.c). */
+#ifndef NETSURF_FB_WAVEOS_H
+#define NETSURF_FB_WAVEOS_H
+
+#include <stddef.h>
+
+/* Keys the WaveOS surface sends for going back and forward (mouse side
+ * buttons, browser keys, Alt+Left and Alt+Right). */
+#define WAVEOS_KEY_BACK 0x20000001
+#define WAVEOS_KEY_FORWARD 0x20000002
+
+int waveos_scale(void);
+/* The page zoom when changed from the keyboard (0: the display scale). */
+extern float waveos_zoom;
+void waveos_set_defaults(void);
+const char *waveos_url(const char *arg);
+void waveos_clipboard_get(char **buffer, size_t *length);
+void waveos_clipboard_set(const char *buffer, size_t length);
+
+#endif
